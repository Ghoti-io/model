#!/bin/sh
# What OpenSCAD says it is. First line only.
#
# This release does not read or write OBJ. The pin is here so a later format
# that does ask OpenSCAD is answered by the release this file names, rather
# than by whatever the machine has installed on that day.
out=$(openscad --version 2>&1) || exit 1
line=$(printf '%s\n' "$out" | head -1)
if [ -z "$line" ]; then
  printf '%s\n' "$out" >&2
  exit 1
fi
printf '%s\n' "$line"
